# Telegram Bot Ayarları (Opsiyonel)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Cloudflare Bypass - FlareSolverr (Önerilen)
# Docker ile çalıştırın: docker run -d -p 8191:8191 flaresolverr/flaresolverr:latest
FLARESOLVERR_URL=http://localhost:8191

# Alternatif: Manuel Cookie (FlareSolverr yoksa kullanın)
# Tarayıcınızdan cf_clearance cookie değerini kopyalayın
CF_COOKIE=your_cf_clearance_cookie_here
